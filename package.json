{
  "name": "scorpio",
  "version": "0.1.0",
  "license": "MIT",
  "engines": {
    "node": ">=22",
    "npm": ">=11"
  },
  "scripts": {
    "setup": "npm ci && npm ci --prefix functions",
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "test": "jest",
    "typecheck": "tsc --noEmit && tsc --noEmit -p functions",
    "test:ci": "jest --ci",
    "test:security": "firebase emulators:exec --only firestore,storage --project demo-scorpio-security --config firebase.test.json 'jest --config jest.security.config.cjs --runInBand'",
    "dev:emulators": "firebase emulators:start --only auth,firestore,storage --project demo-scorpio",
    "dev:emulators:alt": "firebase emulators:start --only auth,firestore,storage --project demo-scorpio --config firebase.emulators.alt.json",
    "prepare": "node -e \"try{if(!process.env.CI&&require('fs').existsSync('.git')){require('child_process').execSync('husky',{stdio:'ignore'})}}catch(e){}\""
  },
  "dependencies": {
    "@afixt/a11y-calc": "^0.2.2",
